<Window x:Class="PyPackager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PyPackager · Python 一键打包 EXE / APK"
        Height="860" Width="1180"
        MinHeight="700" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,20,16,20">
                    <TextBlock Text="🐍" FontSize="24" VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PyPackager" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Python → EXE / APK" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Text="v0.2.0" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" Margin="16,0,0,12"/>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavExe" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="📦  EXE 打包" IsChecked="True" Checked="Nav_Checked" Tag="Exe"/>
                    <RadioButton x:Name="NavApk" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="📱  APK 打包" Checked="Nav_Checked" Tag="Apk"/>
                    <RadioButton x:Name="NavDeploy" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="☁  服务器部署" Checked="Nav_Checked" Tag="Deploy"/>
                    <RadioButton x:Name="NavBatch" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="🗂  批量打包" Checked="Nav_Checked" Tag="Batch"/>
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="🕓  打包历史" Checked="Nav_Checked" Tag="History"/>
                    <RadioButton x:Name="NavEnv" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="⚙️  环境管理" Checked="Nav_Checked" Tag="Env"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 右侧内容 + 状态栏 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0" x:Name="ContentHost"/>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="16,8">
                <TextBlock x:Name="StatusBar" Text="就绪" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Grid>
</Window>
