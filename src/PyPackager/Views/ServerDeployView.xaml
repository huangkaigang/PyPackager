<UserControl x:Class="PyPackager.Views.ServerDeployView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="服务器部署（云端 APK 编译）" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="填入 Linux 服务器的 SSH 登录信息，一键自动完成：识别系统版本 → 安装并配置 Docker（自动避开网段冲突）→ 上传并构建 APK 编译服务 → 健康检查。完成后服务器地址会自动回填到「APK 打包」页的云端后端。"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- 支持的服务器系统列表（含 32/64 位） -->
        <GroupBox Grid.Row="1" Header="支持的服务器系统（含 32 / 64 位）">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="132"
                          Background="{StaticResource SurfaceBrush}">
                <ItemsControl x:Name="SupportedList" Margin="4"/>
            </ScrollViewer>
        </GroupBox>

        <!-- SSH 连接配置 -->
        <GroupBox Grid.Row="2" Header="① SSH 连接">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="主机 / IP" Style="{StaticResource Label}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HostBox" Margin="0,4,12,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="端口" Style="{StaticResource Label}"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="PortBox" Margin="0,4,0,4" Text="22"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="用户名" Style="{StaticResource Label}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="UserBox" Margin="0,4,12,4" Text="root"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="服务端口" Style="{StaticResource Label}"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="ServicePortBox" Margin="0,4,0,4" Text="8000"/>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,6">
                    <TextBlock Text="认证" Style="{StaticResource Label}"/>
                    <RadioButton x:Name="AuthPassword" Content="密码" GroupName="Auth" IsChecked="True" Checked="Auth_Changed"/>
                    <RadioButton x:Name="AuthKey" Content="私钥文件" GroupName="Auth" Checked="Auth_Changed"/>
                </StackPanel>

                <!-- 密码认证 -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" x:Name="PasswordPanel" Orientation="Horizontal">
                    <TextBlock Text="密码" Style="{StaticResource Label}" MinWidth="60"/>
                    <PasswordBox x:Name="PasswordBox" Width="260" Margin="0,0,12,0"
                                 Background="{StaticResource OverlayBrush}" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" Padding="6,4"/>
                    <CheckBox x:Name="SaveCredCheck" Content="记住凭据（DPAPI 加密存本地）" IsChecked="True"/>
                </StackPanel>

                <!-- 私钥认证 -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" x:Name="KeyPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="私钥" Style="{StaticResource Label}" MinWidth="60"/>
                    <TextBox x:Name="KeyPathBox" Width="320" Margin="0,0,8,0"/>
                    <Button Content="浏览…" Click="BrowseKey_Click" Padding="10,5"/>
                    <TextBlock Text="口令" Style="{StaticResource Label}" Margin="12,0,6,0"/>
                    <PasswordBox x:Name="PassphraseBox" Width="140"
                                 Background="{StaticResource OverlayBrush}" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" Padding="6,4"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="TestBtn" Content="🔗 测试连接" Click="Test_Click"/>
            <Button x:Name="DeployBtn" Content="🚀 一键部署 APK 编译服务" Style="{StaticResource Primary}" Click="Deploy_Click"/>
            <Button x:Name="CancelBtn" Content="✖ 取消" Style="{StaticResource Danger}" Click="Cancel_Click" IsEnabled="False"/>
            <Button x:Name="OpenBrowserBtn" Content="🌐 打开服务地址" Click="OpenBrowser_Click"/>
        </StackPanel>

        <!-- 结果横幅：成功 / 失败 / 异常 都常驻页面显示 -->
        <Border Grid.Row="4" x:Name="ResultBanner" Visibility="Collapsed"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="12.5"
                       MaxHeight="120" TextTrimming="None"/>
        </Border>

        <!-- 探测结果 -->
        <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel x:Name="OsPanel">
                <TextBlock x:Name="OsSummary" Text="尚未连接。填好信息后点「测试连接」，或直接「一键部署」。"
                           Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 进度 -->
        <Grid Grid.Row="6" Margin="0,0,0,10">
            <ProgressBar x:Name="Progress" Height="16" Minimum="0" Maximum="100"
                         Background="{StaticResource OverlayBrush}" Foreground="{StaticResource GreenBrush}" BorderThickness="0"/>
            <TextBlock x:Name="ProgressText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="11" Foreground="#1E1E2E" FontWeight="Bold" Text=""/>
        </Grid>

        <GroupBox Grid.Row="7" Header="部署日志">
            <TextBox x:Name="LogBox" Style="{StaticResource LogBox}"/>
        </GroupBox>
    </Grid>
</UserControl>
