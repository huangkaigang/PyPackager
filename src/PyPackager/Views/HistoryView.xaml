<UserControl x:Class="PyPackager.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="打包历史" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="记录每次打包任务的项目、引擎、结果与耗时。可打开产物目录或一键清空。历史保存在本地，不上传。"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="RefreshBtn" Content="🔄 刷新" Click="Refresh_Click"/>
            <Button x:Name="OpenBtn" Content="📂 打开选中产物目录" Click="Open_Click"/>
            <Button x:Name="ClearBtn" Content="🗑 清空历史" Style="{StaticResource Danger}" Click="Clear_Click"/>
            <TextBlock x:Name="CountText" Style="{StaticResource Label}" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="4">
            <ListView x:Name="HistoryList" Background="Transparent" BorderThickness="0"
                      Foreground="{StaticResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="时间" Width="140" DisplayMemberBinding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                        <GridViewColumn Header="项目" Width="300" DisplayMemberBinding="{Binding ProjectPath}"/>
                        <GridViewColumn Header="引擎" Width="90" DisplayMemberBinding="{Binding Engine}"/>
                        <GridViewColumn Header="结果" Width="70" DisplayMemberBinding="{Binding StatusText}"/>
                        <GridViewColumn Header="耗时" Width="70" DisplayMemberBinding="{Binding DurationText}"/>
                        <GridViewColumn Header="产物 / 错误" Width="360" DisplayMemberBinding="{Binding OutputOrError}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
