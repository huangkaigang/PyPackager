<UserControl x:Class="PyPackager.Views.EnvironmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="环境管理" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="检测本机 Python 与打包工具链。若系统环境缺少 PyInstaller / Nuitka，可一键在内部虚拟环境中自动装好，打包时会自动切换使用，不污染你的全局 Python。"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="DetectBtn" Content="🔍 重新检测" Click="Detect_Click"/>
            <Button x:Name="InitBtn" Content="⚙️ 一键初始化内部环境" Style="{StaticResource Primary}" Click="Init_Click"/>
            <Button x:Name="ResetBtn" Content="🗑 重置内部环境" Style="{StaticResource Danger}" Click="Reset_Click"/>
            <Button x:Name="OpenVenvBtn" Content="📂 打开 venv 目录" Click="OpenVenv_Click"/>
        </StackPanel>

        <!-- 检测结果卡片 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid x:Name="ReportGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" x:Name="LeftCol"/>
                <StackPanel Grid.Column="1" x:Name="RightCol"/>
            </Grid>
        </Border>

        <!-- 托管 Python 运行时（多目标打包用） -->
        <GroupBox Grid.Row="3" Header="托管 Python 运行时（多目标打包：不同 Windows 版本 / 32-64 位）" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="pip 镜像" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="MirrorCombo" Width="150"/>
                    <Button x:Name="ApplyMirrorBtn" Content="应用" Click="ApplyMirror_Click" Padding="10,5"/>
                    <TextBlock Text="Python 版本" Style="{StaticResource Label}" Margin="16,0,8,0"/>
                    <ComboBox x:Name="VersionCombo" Width="120" IsEditable="True" Text="3.8.10">
                        <ComboBoxItem Content="3.8.10"/>
                        <ComboBoxItem Content="3.11.9"/>
                        <ComboBoxItem Content="3.12.10"/>
                        <ComboBoxItem Content="3.13.5"/>
                    </ComboBox>
                    <TextBlock Text="架构" Style="{StaticResource Label}" Margin="12,0,8,0"/>
                    <ComboBox x:Name="RtArchCombo" Width="110">
                        <ComboBoxItem Content="x86（32 位）" IsSelected="True"/>
                        <ComboBoxItem Content="x64（64 位）"/>
                    </ComboBox>
                    <Button x:Name="DownloadRtBtn" Content="⬇ 下载并装 PyInstaller" Style="{StaticResource Primary}" Click="DownloadRuntime_Click"/>
                    <Button x:Name="DeleteRtBtn" Content="🗑 删除选中" Style="{StaticResource Danger}" Click="DeleteRuntime_Click"/>
                    <Button x:Name="OpenRtBtn" Content="📂 打开目录" Click="OpenRuntimes_Click"/>
                </StackPanel>
                <ListBox x:Name="RuntimeList" Height="90" Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           Text="在 EXE / 批量页选择“目标系统 + 架构”后会自动按需下载对应运行时；也可在此预先下载。运行时来自 NuGet 官方 CPython 包（含 ensurepip，离线引导），引擎从所选 pip 镜像安装。Win7 目标请用 3.8.10。"/>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <ProgressBar x:Name="Progress" Height="16" Minimum="0" Maximum="100"
                         Background="{StaticResource OverlayBrush}" Foreground="{StaticResource GreenBrush}" BorderThickness="0"/>
            <TextBlock x:Name="ProgressText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="11" Foreground="#1E1E2E" FontWeight="Bold" Text=""/>
        </Grid>

        <GroupBox Grid.Row="5" Header="初始化日志">
            <TextBox x:Name="LogBox" Style="{StaticResource LogBox}"/>
        </GroupBox>
    </Grid>
</UserControl>
